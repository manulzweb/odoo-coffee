<odoo>
    <!-- Vista de árbol para administrar roles -->
    <record id="view_contact_role_list" model="ir.ui.view">
        <field name="name">contact.role.list</field>
        <field name="model">contact.role</field>
        <field name="arch" type="xml">
            <list string="Roles de Contacto">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para crear/editar roles -->
    <record id="view_contact_role_form" model="ir.ui.view">
        <field name="name">contact.role.form</field>
        <field name="model">contact.role</field>
        <field name="arch" type="xml">
            <form string="Rol de Contacto">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir la vista -->
    <record id="action_contact_role" model="ir.actions.act_window">
        <field name="name">Roles de Contactos</field>
        <field name="res_model">contact.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Crea y administra los roles que podrán seleccionarse para los contactos.
            </p>
        </field>
    </record>

</odoo>
