<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_blind_cash_closing_list" model="ir.ui.view">
        <field name="name">pos.blind.cash.closing.list</field>
        <field name="model">pos.blind.cash.closing</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="difference &lt; 0" decoration-warning="difference &gt; 0">
                <field name="counted_at"/>
                <field name="session_name"/>
                <field name="config_id"/>
                <field name="cashier_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="opening_cash" optional="show"/>
                <field name="expected_cash"/>
                <field name="counted_cash"/>
                <field name="difference" sum="Total"/>
                <field name="difference_at_count" optional="hide"/>
                <field name="opening_discrepancy" optional="show"/>
                <field name="calc_after_close" optional="hide"/>
                <field name="odoo_mismatch" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pos_blind_cash_closing_form" model="ir.ui.view">
        <field name="name">pos.blind.cash.closing.form</field>
        <field name="model">pos.blind.cash.closing</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="config_id"/>
                            <field name="cashier_id"/>
                            <field name="state"/>
                            <field name="counted_at"/>
                            <field name="closed_at"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="opening_cash"/>
                            <field name="cash_sales"/>
                            <field name="cash_moves"/>
                            <field name="expected_cash"/>
                            <field name="counted_cash"/>
                            <field name="difference"/>
                            <field name="difference_at_count"/>
                            <field name="cash_sales_after_count"/>
                            <field name="odoo_expected_cash"/>
                            <field name="odoo_mismatch"/>
                            <field name="has_previous"/>
                            <field name="previous_counted_cash"/>
                            <field name="opening_discrepancy"/>
                            <field name="calc_after_close"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_blind_cash_closing_pivot" model="ir.ui.view">
        <field name="name">pos.blind.cash.closing.pivot</field>
        <field name="model">pos.blind.cash.closing</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="counted_at" interval="month" type="row"/>
                <field name="cashier_id" type="col"/>
                <field name="difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_blind_cash_closing_search" model="ir.ui.view">
        <field name="name">pos.blind.cash.closing.search</field>
        <field name="model">pos.blind.cash.closing</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_name"/>
                <field name="cashier_id"/>
                <filter name="with_difference" string="Con diferencia" domain="[('difference', '!=', 0)]"/>
                <filter name="opening_diff" string="Apertura distinta del cierre anterior" domain="[('opening_discrepancy', '!=', 0)]"/>
                <filter name="shortage" string="Faltante" domain="[('difference', '&lt;', 0)]"/>
                <filter name="surplus" string="Sobrante" domain="[('difference', '&gt;', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_cashier" string="Cajero" context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_day" string="Dia" context="{'group_by': 'counted_at:day'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'counted_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_blind_cash_closing" model="ir.actions.act_window">
        <field name="name">Diferencias de caja</field>
        <field name="res_model">pos.blind.cash.closing</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <menuitem id="menu_pos_blind_cash_closing_root" name="Cierres de caja" sequence="90"
              groups="pos_order_integrity.group_pos_store_manager,base.group_system"/>
    <menuitem id="menu_pos_blind_cash_closing" name="Diferencias de caja"
              parent="menu_pos_blind_cash_closing_root" action="action_pos_blind_cash_closing" sequence="10"
              groups="pos_order_integrity.group_pos_store_manager,base.group_system"/>
</odoo>
