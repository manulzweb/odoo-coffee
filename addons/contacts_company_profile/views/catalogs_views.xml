<odoo>

    <!-- ===================================================== -->
    <!-- TIPO DE CLIENTE -->
    <!-- ===================================================== -->

    <record id="view_company_client_type_list" model="ir.ui.view">
        <field name="name">company.client.type.list</field>
        <field name="model">company.client.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_company_client_type_form" model="ir.ui.view">
        <field name="name">company.client.type.form</field>
        <field name="model">company.client.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_client_type" model="ir.actions.act_window">
        <field name="name">Tipo de Cliente</field>
        <field name="res_model">company.client.type</field>
        <field name="view_mode">list,form</field>
    </record>


