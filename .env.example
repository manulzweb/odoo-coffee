
# ==========================================================
# CONFIGURACION GENERAL
# ==========================================================

COMPOSE_PROJECT_NAME=saas-odoo

# ==========================================================
# POSTGRESQL
# ==========================================================

POSTGRES_IMAGE=postgres:16

POSTGRES_CONTAINER_NAME=sass-data-base

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

POSTGRES_PORT=5432

# ==========================================================
# ODOO
# ==========================================================

ODOO_IMAGE=odoo:18.0

ODOO_CONTAINER_NAME=saas-odoo

ODOO_PORT=8069

# ==========================================================
# RECURSOS DE LOS CONTENEDORESs
# ==========================================================

POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G

ODOO_CPU_LIMIT=2.0
ODOO_MEMORY_LIMIT=2G

# ==========================================================
# HEALTHCHECK POSTGRESQL
# ==========================================================

POSTGRES_HEALTH_INTERVAL=10s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=5
POSTGRES_HEALTH_START_PERIOD=30s

# ==========================================================
# LOGS
# ==========================================================

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ==========================================================
# CADDY / TENANTS  (un host por restaurante; el subdominio = nombre de la DB)
# ==========================================================

# Local:      http://pizzeria.localhost http://sushi.localhost
# Produccion: pizzeria.midominio.co sushi.midominio.co
TENANT_HOSTS="http://pizzeria.localhost http://sushi.localhost"

BACKUP_KEEP_DAYS=7

# Ruta secreta del backend: /admin-<ADMIN_KEY>  (generar con: openssl rand -hex 8)
ADMIN_KEY=cambiame
